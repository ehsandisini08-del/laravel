{
  "name": "wa-gateway",
  "version": "2.0.0",
  "description": "WhatsApp Gateway using Baileys - Always-On Edition",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "pm2:install": "npm install pm2 --save-dev && bash scripts/install-pm2.sh",
    "pm2:start": "pm2 start ecosystem.config.js",
    "pm2:stop": "pm2 stop wa-gateway",
    "pm2:restart": "pm2 restart wa-gateway",
    "pm2:delete": "pm2 delete wa-gateway",
    "pm2:logs": "pm2 logs wa-gateway",
    "pm2:monit": "pm2 monit",
    "pm2:status": "pm2 status"
  },
  "dependencies": {
    "@whiskeysockets/baileys": "^6.7.24",
    "express": "^4.21.0",
    "pino": "^9.4.0",
    "pino-pretty": "^11.2.0",
    "qrcode": "^1.5.4",
    "dotenv": "^16.4.5"
  },
  "devDependencies": {
    "pm2": "^5.3.0"
  }
}